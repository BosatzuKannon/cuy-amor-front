{
  "expo": {
    "name": "front-cuy-amor",
    "slug": "front-cuy-amor",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon1.png",
    "scheme": "frontcuyamor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bosatzu.frontcuyamor",
      "versionCode": 3
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para que puedas mostrar tu perfil a tu cuy ideal."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cuy Amor usa tu ubicación para mostrarte perfiles cercanos en Nariño."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8521adf6-2dcb-4ce1-b17b-8adc98a1dc03"
      }
    }
  }
}
