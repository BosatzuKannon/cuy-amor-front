{
  "expo": {
    "name": "Cuy Amor",
    "slug": "front-cuy-amor",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon3.png",
    "scheme": "cuyamor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E2725B",
        "foregroundImage": "./assets/images/icon3.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/icon3.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bosatzu.frontcuyamor",
      "versionCode": 6
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E2725B",
          "resizeMode": "contain",
          "image": "./assets/images/splash-icon1.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para que puedas mostrar tu perfil a tu cuy ideal."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cuy Amor usa tu ubicación para mostrarte perfiles cercanos en Nariño."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8521adf6-2dcb-4ce1-b17b-8adc98a1dc03"
      }
    }
  }
}
